check process celeryd-{{ service_name }}
    matching "celery -A {{ celery_app_name }} worker"
{% if uses_systemd == None or uses_systemd == False %}
    start program = "/etc/init.d/celeryd-ona start" as uid root and gid root
    stop program = "/etc/init.d/celeryd-ona stop" as uid root and gid root
{% else %}
    start program = "/bin/systemctl start celeryd-{{ service_name }}" with timeout 60 seconds
    stop program = "/bin/systemctl stop celeryd-{{ service_name }}" with timeout 60 seconds
{% endif %}
    if does not exist for 3 cycles then restart
    if totalmem is greater than {{ celeryd_monit_total_mem_limit | default('3000.0') }} MB for 3 cycles then restart
    if 7 restarts within 10 cycles then unmonitor
    group celery
